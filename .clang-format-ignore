# Files clang-format must not reformat.
# One repo-relative glob per line (matched relative to this file's directory).

# cfg_wasm.cpp is raw JavaScript glue inside EM_ASM(...) macros. Even with
# clang-format off/on guards, clang-format still parses the guarded tokens, and
# JS methods with statements in braces (`getItem(key){ return x; }`) derail its
# parser, mis-indenting the rest of the file. Keep it hand-formatted instead.
src/cfg/cfg_wasm.cpp

# fs_osx.mm is Objective-C++; this project's .clang-format has no ObjC
# language mode, so clang-format refuses to reformat it (and is not
# idempotent when forced). Keep it hand-formatted instead.
src/base/fs_osx.mm

# These she/osx/*.h headers contain Objective-C constructs (blocks, @interface
# forward decls, etc); same "no ObjC language mode" limitation as fs_osx.mm
# above. clang-format refuses to touch them at all. Keep hand-formatted.
src/she/osx/app_delegate.h
src/she/osx/generate_drop_files.h
src/she/osx/view.h
