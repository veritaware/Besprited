<gui>
  <window text="Script Permissions" id="script_permissions">
    <vbox>
      <box id="script_name_placeholder" /><!-- custom widget -->
      <label text="requests the following permissions:" />
      <check id="perm_fs_read" text="Read files (fs.read)" tooltip="fs.readFile, fs.stat, fs.listDir, fs.shareFile" />
      <check id="perm_fs_write" text="Write and delete files (fs.write)" tooltip="fs.writeFile, fs.copyFile, fs.deleteFile" />
      <check id="perm_net_fetch" text="Make network requests (net.fetch)" tooltip="fetch and storage.fetch" />
      <check id="perm_net_serve" text="Serve HTTP (net.serve)" tooltip="HTTPServer (listening on a port); static file serving also needs fs.read" />
      <check id="perm_app_launch_url" text="Open web URLs (app.launch.url)" tooltip="app.launch with an http(s) URL" />
      <check id="perm_app_launch_other" text="Open files or launch programs (app.launch.other)" tooltip="app.launch with a file/path, child_process, and commands that open files/folders" />
      <hbox>
        <boxfiller />
        <hbox homogeneous="true">
          <button text="&amp;OK" closewindow="true" id="ok" magnet="true" width="60" />
          <button text="&amp;Cancel" closewindow="true" id="cancel" />
        </hbox>
      </hbox>
    </vbox>
  </window>
</gui>
